# Copy this file to .env and fill in local values. Never commit .env.
# Values are examples; real keys are shared privately in the team.
# Docker Compose reads this file; every variable has a default in compose.yaml,
# so `docker compose up` also works before .env exists.

# Database (PostgreSQL/PostGIS)
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas

# Ports published on the host
DB_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
VISION_PORT=8001
DASHBOARD_PORT=8080

# Backend, when it runs outside Docker (inside Compose these are set in compose.yaml)
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas
REDIS_URL=redis://localhost:6379/0

# Routing service (provider chosen by the routing API research)
ROUTING_API_KEY=

# Firebase Cloud Messaging
FCM_CREDENTIALS_FILE=
